{"schemaVersion":1,"generation":6,"records":{"com.gonavi.nginx-inspector":{"manifest":{"schemaVersion":1,"apiVersion":1,"id":"com.gonavi.nginx-inspector","name":"Nginx Inspector","version":"1.0.0","description":"Read-only nginx diagnostics over SSH: config tree with include expansion, nginx -t validation, gated reload, error/access log tailing and search, access log statistics, TLS certificate expiry review and upstream health probes.","author":"GoNavi","license":"Apache-2.0","minHostVersion":"1.1.5","permissions":["ai.tools","ai.skills","host.log"],"permissionNotes":{"ai.skills":"Ships the nginx-triage skill document for explicit Agent loading.","ai.tools":"Exposes the nginx diagnostics commands to the GoNavi Agent. Write commands (connection edits, service reload) still require explicit approval.","host.log":"Writes bounded diagnostics while connecting and executing remote commands."},"backend":{"platforms":{"darwin/amd64":{"executable":"bin/plugin-darwin-amd64","runtime":"native"},"darwin/arm64":{"executable":"bin/plugin-darwin-arm64","runtime":"native"},"linux/amd64":{"executable":"bin/plugin-linux-amd64","runtime":"native"},"linux/arm64":{"executable":"bin/plugin-linux-arm64","runtime":"native"},"windows/amd64":{"executable":"bin/plugin-windows-amd64.exe","runtime":"native"}}},"contributes":{"commands":[{"id":"connections.list","title":"List nginx SSH connections","inputSchema":{"type":"object"},"effect":"read"},{"id":"connections.save","title":"Save an nginx SSH connection profile","inputSchema":{"type":"object","properties":{"id":{"type":"string","maxLength":64},"name":{"type":"string","maxLength":100},"host":{"type":"string","maxLength":255},"port":{"type":"integer","minimum":1,"maximum":65535},"username":{"type":"string","maxLength":100},"authType":{"type":"string","enum":["password","key"]},"password":{"type":"string","maxLength":1024},"keyPath":{"type":"string","maxLength":1024},"keyPassphrase":{"type":"string","maxLength":1024}},"required":["name","host","port","username","authType"]},"effect":"write"},{"id":"connections.delete","title":"Delete an nginx SSH connection profile","inputSchema":{"type":"object","properties":{"id":{"type":"string","maxLength":64}},"required":["id"]},"effect":"write"},{"id":"connections.test","title":"Test an nginx SSH connection","inputSchema":{"type":"object","properties":{"id":{"type":"string","maxLength":64}},"required":["id"]},"effect":"read"},{"id":"host.info","title":"Discover the remote nginx installation","inputSchema":{"type":"object","properties":{"connectionId":{"type":"string","maxLength":64},"refresh":{"type":"boolean"}},"required":["connectionId"]},"effect":"read"},{"id":"config.tree","title":"Load the parsed nginx configuration tree","inputSchema":{"type":"object","properties":{"connectionId":{"type":"string","maxLength":64}},"required":["connectionId"]},"effect":"read"},{"id":"config.get","title":"Read one remote nginx configuration file","inputSchema":{"type":"object","properties":{"connectionId":{"type":"string","maxLength":64},"path":{"type":"string","maxLength":4096}},"required":["connectionId","path"]},"effect":"read"},{"id":"config.validate","title":"Validate the configuration with nginx -t","inputSchema":{"type":"object","properties":{"connectionId":{"type":"string","maxLength":64}},"required":["connectionId"]},"effect":"read"},{"id":"service.status","title":"Read the nginx service status","inputSchema":{"type":"object","properties":{"connectionId":{"type":"string","maxLength":64}},"required":["connectionId"]},"effect":"read"},{"id":"service.reload","title":"Reload nginx after a successful nginx -t","inputSchema":{"type":"object","properties":{"connectionId":{"type":"string","maxLength":64},"confirm":{"type":"boolean"},"method":{"type":"string","enum":["auto","signal","systemd"]}},"required":["connectionId","confirm"]},"effect":"write"},{"id":"logs.tail","title":"Tail an nginx log file","inputSchema":{"type":"object","properties":{"connectionId":{"type":"string","