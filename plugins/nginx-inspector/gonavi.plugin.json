{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "com.gonavi.nginx-inspector",
  "name": "Nginx Inspector",
  "version": "1.0.0",
  "description": "Read-only nginx diagnostics over SSH: config tree with include expansion, nginx -t validation, gated reload, error/access log tailing and search, access log statistics, TLS certificate expiry review and upstream health probes.",
  "author": "GoNavi",
  "license": "Apache-2.0",
  "minHostVersion": "1.1.5",
  "permissions": ["ai.tools", "ai.skills", "host.log"],
  "permissionNotes": {
    "ai.tools": "Exposes the nginx diagnostics commands to the GoNavi Agent. Write commands (connection edits, service reload) still require explicit approval.",
    "ai.skills": "Ships the nginx-triage skill document for explicit Agent loading.",
    "host.log": "Writes bounded diagnostics while connecting and executing remote commands."
  },
  "backend": {
    "default": {
      "executable": "bin/plugin",
      "runtime": "native"
    }
  },
  "window": {
    "entry": "ui/index.html",
    "title": "Nginx Inspector",
    "width": 1280,
    "height": 840
  },
  "contributes": {
    "commands": [
      {
        "id": "connections.list",
        "title": "List nginx SSH connections",
        "effect": "read",
        "inputSchema": { "type": "object" }
      },
      {
        "id": "connections.save",
        "title": "Save an nginx SSH connection profile",
        "effect": "write",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "maxLength": 64 },
            "name": { "type": "string", "maxLength": 100 },
            "host": { "type": "string", "maxLength": 255 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "username": { "type": "string", "maxLength": 100 },
            "authType": { "type": "string", "enum": ["password", "key"] },
            "password": { "type": "string", "maxLength": 1024 },
            "keyPath": { "type": "string", "maxLength": 1024 },
            "keyPassphrase": { "type": "string", "maxLength": 1024 }
          },
          "required": ["name", "host", "port", "username", "authType"]
        }
      },
      {
        "id": "connections.delete",
        "title": "Delete an nginx SSH connection profile",
        "effect": "write",
        "inputSchema": {
          "type": "object",
          "properties": { "id": { "type": "string", "maxLength": 64 } },
          "required": ["id"]
        }
      },
      {
        "id": "connections.test",
        "title": "Test an nginx SSH connection",
        "effect": "read",
        "inputSchema": {
          "type": "object",
          "properties": { "id": { "type": "string", "maxLength": 64 } },
          "required": ["id"]
        }
      },
      {
        "id": "host.info",
        "title": "Discover the remote nginx installation",
        "effect": "read",
        "inputSchema": {
          "type": "object",
          "properties": {
            "connectionId": { "type": "string", "maxLength": 64 },
            "refresh": { "type": "boolean" }
          },
          "required": ["connectionId"]
        }
      },
      {
        "id": "config.tree",
        "title": "Load the parsed nginx configuration tree",
        "effect": "read",
        "inputSchema": {
          "type": "object",
          "properties": { "connectionId": { "type": "string", "maxLength": 64 } },
          "required": ["connectionId"]
        }
      },
      {
        "id": "config.get",
        "title": "Read one remote nginx configuration file",
        "effect": "read",
        "inputSchema": {
          "type": "object",
          "properties": {
            "connectionId": { "type": "string", "maxLength": 64 },
            "path": { "type": "string", "maxLength": 4096 }
          },
          "required": ["connectionId", "path"]
        }
      },
      {
        "id": "config.validate",
        "title": "Validate the configuration with nginx -t",
        "effect": "read",
        "inputSchema": {
          "type": "object",
          "properties": { "connectionId": { "type": "string", "maxLength": 64 } },
          "required": ["connectionId"]
        }
      },
      {
        "id": "service.status",
        "title": "Read the nginx service status",
        "effect": "read",
        "inputSchema": {
          "type": "object",
          "properties": { "connectionId": { "type": "string", "maxLength": 64 } },
          "required": ["connectionId"]
        }
      },
      {
        "id": "service.reload",
        "title": "Reload nginx after a successful nginx -t",
        "effect": "write",
        "inputSchema": {
          "type": "object",
          "properties": {
            "connectionId": { "type": "string", "maxLength": 64 },
            "confirm": { "type": "boolean" },
            "method": { "type": "string", "enum": ["auto", "signal", "systemd"] }
          },
          "required": ["connectionId", "confirm"]
        }
      },
      {
        "id": "logs.tail",
        "title": "Tail an nginx log file",
        "effect": "read",
        "inputSchema": {
          "type": "object",
          "properties": {
            "connectionId": { "type": "string", "maxLength": 64 },
            "kind": { "type": "string", "enum": ["error", "access"] },
            "path": { "type": "string", "maxLength": 4096 },
            "lines": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "filter": { "type": "string", "maxLength": 256 }
          },
          "required": ["connectionId"]
        }
      },
      {
        "id": "logs.search",
        "title": "Search a bounded window of an nginx log",
        "effect": "read",
        "inputSchema": {
          "type": "object",
          "properties": {
            "connectionId": { "type": "string", "maxLength": 64 },
            "kind": { "type": "string", "enum": ["error", "access"] },
            "path": { "type": "string", "maxLength": 4096 },
            "pattern": { "type": "string", "maxLength": 256 },
            "bytes": { "type": "integer", "minimum": 1024, "maximum": 52428800 },
            "maxMatches": { "type": "integer", "minimum": 1, "maximum": 500 }
          },
          "required": ["connectionId", "pattern"]
        }
      },
      {
        "id": "access.stats",
        "title": "Aggregate access log statistics",
        "effect": "read",
        "inputSchema": {
          "type": "object",
          "properties": {
            "connectionId": { "type": "string", "maxLength": 64 },
            "path": { "type": "string", "maxLength": 4096 },
            "bytes": { "type": "integer", "minimum": 65536, "maximum": 104857600 }
          },
          "required": ["connectionId"]
        }
      },
      {
        "id": "certs.list",
        "title": "Review TLS certificates referenced by the configuration",
        "effect": "read",
        "inputSchema": {
          "type": "object",
          "properties": { "connectionId": { "type": "string", "maxLength": 64 } },
          "required": ["connectionId"]
        }
      },
      {
        "id": "upstreams.check",
        "title": "Probe upstream servers from the remote host",
        "effect": "read",
        "inputSchema": {
          "type": "object",
          "properties": { "connectionId": { "type": "string", "maxLength": 64 } },
          "required": ["connectionId"]
        }
      }
    ],
    "panels": [
      {
        "id": "welcome",
        "title": "Nginx Inspector",
        "body": {
          "type": "column",
          "children": [
            {
              "type": "text",
              "text": "Read-only nginx diagnostics over SSH. This panel is declarative; open the plugin window for the full UI."
            },
            {
              "type": "text",
              "text": "Workflow: save an SSH connection, discover the nginx installation, inspect the config tree, validate with nginx -t, then analyze logs, statistics, certificates and upstreams."
            },
            {
              "type": "alert",
              "text": "Reload is the only write command. It refuses to run when nginx -t reports errors and requires explicit confirmation."
            }
          ]
        }
      }
    ],
    "skills": [
      {
        "id": "nginx-triage",
        "name": "Nginx triage",
        "description": "Bounded, read-only nginx triage workflow over SSH: validate configuration, inspect config structure, analyze error and access logs, review certificate expiry and probe upstreams. Loading this reference does not authorize commands; every tool call still requires approval.",
        "entry": "skills/nginx-triage/SKILL.md",
        "resources": ["skills/nginx-triage/REFERENCE.md"]
      }
    ]
  }
}
