{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "com.gonavi.mongo-shell",
  "name": "MongoShell",
  "version": "1.0.3",
  "description": "Interactive MongoDB JavaScript shell in a dedicated GoNavi window or workbench tab: connect with the saved connection, browse databases, and run bounded goja scripts with find, aggregate, insert, update, delete and runCommand.",
  "author": "GoNavi",
  "license": "Apache-2.0",
  "minHostVersion": "1.2.0",
  "permissions": [
    "host.connections.credentials",
    "host.log",
    "ai.skills",
    "ui.pages",
    "ui.html-panel"
  ],
  "permissionNotes": {
    "host.connections.credentials": "Reads the saved MongoDB configuration, including credentials, from the launch context. Credentials are used once and never returned.",
    "host.log": "Writes bounded connection diagnostics without credentials.",
    "ai.skills": "Ships the mongo-shell-recipes reference skill document for explicit Agent loading.",
    "ui.pages": "Opens the MongoShell page in a workbench tab.",
    "ui.html-panel": "Renders the inline MongoShell workbench page."
  },
  "backend": {
    "default": {
      "executable": "bin/plugin",
      "runtime": "native"
    }
  },
  "window": {
    "entry": "ui/index.html",
    "title": "MongoShell",
    "width": 1180,
    "height": 780
  },
  "contributes": {
    "commands": [
      {
        "id": "connect",
        "title": "Connect to the saved MongoDB connection",
        "description": "Opens a driver client with the launch-context configuration, verifies it with a bounded ping and returns the database list.",
        "effect": "read",
        "inputSchema": {
          "type": "object",
          "properties": {
            "config": {
              "type": "object"
            },
            "readOnly": {
              "type": "boolean"
            },
            "database": {
              "type": "string",
              "maxLength": 255
            },
            "collection": {
              "type": "string",
              "maxLength": 255
            },
            "connectionId": {
              "type": "string",
              "maxLength": 128
            },
            "connectionName": {
              "type": "string",
              "maxLength": 256
            },
            "environmentType": {
              "type": "string",
              "maxLength": 64
            }
          },
          "required": [
            "config"
          ]
        }
      },
      {
        "id": "disconnect",
        "title": "Disconnect the MongoDB client",
        "effect": "read",
        "inputSchema": {
          "type": "object",
          "properties": {
            "sessionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "sessionId"
          ]
        }
      },
      {
        "id": "ping",
        "title": "Ping the MongoDB server",
        "effect": "read",
        "inputSchema": {
          "type": "object",
          "properties": {
            "sessionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "sessionId"
          ]
        }
      },
      {
        "id": "run",
        "title": "Run a JavaScript shell script",
        "description": "Executes a goja script with the db helper object, print and use. Results are bounded by maxRows and a command timeout.",
        "effect": "unknown",
        "inputSchema": {
          "type": "object",
          "properties": {
            "script": {
              "type": "string"
            },
            "database": {
              "type": "string",
              "maxLength": 255
            },
            "collection": {
              "type": "string",
              "maxLength": 255
            },
            "maxRows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            },
            "sessionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "script",
            "sessionId"
          ]
        }
      }
    ],
    "connectionActions": [
      {
        "id": "open-shell",
        "title": "MongoShell",
        "description": "Open a MongoDB JavaScript shell for this connection, database or collection.",
        "connectionTypes": [
          "mongodb"
        ],
        "scopes": [
          "connection",
          "database",
          "collection"
        ],
        "target": {
          "type": "window"
        }
      },
      {
        "id": "open-shell-tab",
        "title": "MongoShell (Workbench)",
        "description": "Open MongoShell in a workbench tab for this connection, database or collection.",
        "connectionTypes": [
          "mongodb"
        ],
        "scopes": [
          "connection",
          "database",
          "collection"
        ],
        "target": {
          "type": "page",
          "page": "shell"
        }
      }
    ],
    "skills": [
      {
        "id": "mongo-shell-recipes",
        "name": "MongoShell recipes",
        "description": "Reference for the bounded MongoShell JavaScript API: connection context, db/collection helpers, row limits, read-only behaviour and safe query patterns.",
        "entry": "skills/mongo-shell-recipes/SKILL.md"
      }
    ],
    "pages": [
      {
        "id": "shell",
        "title": "MongoShell",
        "html": {
          "source": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n<title>MongoShell</title>\n<style>\n  :root { color-scheme: light dark; font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif; }\n  html, body { margin: 0; min-height: 100%; background: transparent; color: inherit; }\n  body { padding: 14px; box-sizing: border-box; }\n  .bar { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-bottom: 10px; }\n  .bar strong { font-size: 15px; }\n  .muted { opacity: .65; font-size: 12px; }\n  select, input, textarea, button { font: inherit; }\n  select, input { min-height: 30px; padding: 4px 8px; border: 1px solid rgba(127,127,127,.35); border-radius: 6px; background: transparent; color: inherit; }\n  textarea { width: 100%; min-height: 190px; box-sizing: border-box; padding: 10px; border: 1px solid rgba(127,127,127,.35); border-radius: 6px; background: transparent; color: inherit; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; resize: vertical; }\n  button { padding: 5px 12px; border: 1px solid rgba(127,127,127,.35); border-radius: 6px; background: transparent; color: inherit; cursor: pointer; }\n  button.primary { border-color: #0f766e; background: #0f766e; color: #fff; }\n  button:disabled { opacity: .45; cursor: default; }\n  .status { margin-left: auto; font-size: 12px; }\n  .error { border: 1px solid #dc2626; border-radius: 6px; padding: 8px 10px; margin: 10px 0; color: #dc2626; white-space: pre-wrap; }\n  .result { margin-top: 12px; border: 1px solid rgba(127,127,127,.3); border-radius: 6px; padding: 10px; overflow: auto; max-height: 48vh; }\n  pre { margin: 0; white-space: pre-wrap; word-break: break-word; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }\n  table { border-collapse: collapse; width: 100%; font-size: 12px; }\n  th, td { border-bottom: 1px solid rgba(127,127,127,.25); padding: 4px 6px; text-align: left; vertical-align: top; }\n  th { font-weight: 600; }\n</style>\n  <script>\n    // 工作台页是内嵌 iframe：宿主通过 gonavi:host-preferences 注入 locale，\n    // 这里只做最小词典，未识别的语言一律回退英文。\n    (function () {\n      const table = {\n        'zh-CN': { database: '数据库', collection: '集合', optional: '可选', run: '运行', starting: '启动中', connecting: '连接中', ready: '就绪', readOnly: '只读', notConnected: '未连接', running: '执行中', done: '完成', failed: '失败' },\n        'zh-TW': { database: '資料庫', collection: '集合', optional: '選填', run: '執行', starting: '啟動中', connecting: '連線中', ready: '就緒', readOnly: '唯讀', notConnected: '未連線', running: '執行中', done: '完成', failed: '失敗' },\n        'ja-JP': { database: 'データベース', collection: 'コレクション', optional: '任意', run: '実行', starting: '起動中', connecting: '接続中', ready: '準備完了', readOnly: '読み取り専用', notConnected: '未接続', running: '実行中', done: '完了', failed: '失敗' },\n        'de-DE': { database: 'Datenbank', collection: 'Collection', optional: 'optional', run: 'Ausführen', starting: 'Startet', connecting: 'Verbinden', ready: 'Bereit', readOnly: 'Schreibgeschützt', notConnected: 'Nicht verbunden', running: 'Läuft', done: 'Fertig', failed: 'Fehlgeschlagen' },\n        'ru-RU': { database: 'База данных', collection: 'Коллекция', optional: 'необязательно', run: 'Выполнить', starting: 'Запуск', connecting: 'Подключение', ready: 'Готово', readOnly: 'Только чтение', notConnected: 'Нет подключения', running: 'Выполняется', done: 'Готово', failed: 'Ошибка' },\n        'en-US': { database: 'Database', collection: 'Collection', optional: 'optional', run: 'Run', starting: 'starting', connecting: 'connecting', ready: 'ready', readOnly: 'read-only', notConnected: 'not connected', running: 'running', done: 'done', failed: 'failed' },\n      };\n      const resolve = () => {\n        const prefs = window.gonaviHostPrefs;\n        const raw = prefs && typeof prefs.locale === 'string' ? prefs.locale : ((typeof navigator !== 'undefined' && navigator.language) || 'en-US');\n        if (table[raw]) return raw;\n        const lower = String(raw).toLowerCase();\n        if (lower.indexOf('zh') === 0) return lower.indexOf('tw') > -1 || lower.indexOf('hk') > -1 ? 'zh-TW' : 'zh-CN';\n        const base = lower.split('-')[0];\n        for (const key of Object.keys(table)) { if (key.toLowerCase().indexOf(base + '-') === 0) return key; }\n        return 'en-US';\n      };\n      window.__gonaviPageText = (key) => {\n        const locale = resolve();\n        const dict = table[locale] || table['en-US'];\n        return dict[key] || table['en-US'][key] || key;\n      };\n      const apply = () => {\n        for (const node of document.querySelectorAll('[data-i18n]')) node.textContent = window.__gonaviPageText(node.dataset.i18n);\n        for (const node of document.querySelectorAll('[data-i18n-placeholder]')) node.setAttribute('placeholder', window.__gonaviPageText(node.dataset.i18nPlaceholder));\n      };\n      if (typeof window.addEventListener === 'function') {\n        window.addEventListener('message', (event) => {\n          const data = event && event.data;\n          if (data && data.type === 'gonavi:host-preferences') apply();\n        });\n      }\n      if (typeof document.addEventListener === 'function') document.addEventListener('DOMContentLoaded', apply);\n    }());\n  </script>\n</head>\n<body>\n<div class=\"bar\">\n  <strong>MongoShell</strong>\n  <span id=\"conn\" class=\"muted\">connecting…</span>\n  <label class=\"muted\"><span data-i18n=\"database\">Database</span> <select id=\"db\" disabled><option value=\"\">(none)</option></select></label>\n  <label class=\"muted\"><span data-i18n=\"collection\">Collection</span> <input id=\"collection\" placeholder=\"optional\" data-i18n-placeholder=\"optional\" /></label>\n  <button id=\"run\" class=\"primary\" type=\"button\" disabled data-i18n=\"run\">Run</button>\n  <span id=\"status\" class=\"status\" data-i18n=\"starting\">starting</span>\n</div>\n<div id=\"error\" class=\"error\" hidden></div>\n<textarea id=\"editor\" spellcheck=\"false\" aria-label=\"MongoShell JavaScript\">db.getCollectionNames()</textarea>\n<div id=\"result\" class=\"result\" hidden></div>\n<script>\n(() => {\n  const launch = window.__gonaviLaunch || {};\n  const conn = document.getElementById('conn');\n  const dbSelect = document.getElementById('db');\n  const collection = document.getElementById('collection');\n  const editor = document.getElementById('editor');\n  const runButton = document.getElementById('run');\n  const status = document.getElementById('status');\n  const errorBox = document.getElementById('error');\n  const resultBox = document.getElementById('result');\n  let sessionId = '';\n  let disposed = false;\n  let running = false;\n  const setStatus = (text) => { status.textContent = text; };\n  const setError = (error) => {\n    const message = error && (error.message || error.code) ? String(error.message || error.code) : String(error || '');\n    errorBox.hidden = !message;\n    errorBox.textContent = message;\n  };\n  const call = async (command, args) => {\n    const payload = await window.gonavi.call('plugin.invoke', {\n      command,\n      arguments: args || {},\n      connectionId: launch.connectionId || '',\n    });\n    if (!payload || typeof payload !== 'object' || typeof payload.ok !== 'boolean') {\n      throw new Error('The plugin backend returned an invalid response.');\n    }\n    if (!payload.ok) {\n      const failure = payload.error || {};\n      const error = new Error(failure.message || failure.code || 'The command failed.');\n      error.code = failure.code || 'internal';\n      throw error;\n    }\n    if (!payload.data || typeof payload.data !== 'object') {\n      throw new Error('The plugin backend returned invalid data.');\n    }\n    return payload.data;\n  };\n  const release = (id) => call('disconnect', { sessionId: id }).catch(() => {});\n  const dispose = () => {\n    disposed = true;\n    const id = sessionId;\n    sessionId = '';\n    runButton.disabled = true;\n    dbSelect.disabled = true;\n    if (id) void release(id);\n  };\n  const render = (data) => {\n    resultBox.hidden = false;\n    resultBox.textContent = '';\n    if (data && data.table && Array.isArray(data.table.columns) && Array.isArray(data.table.rows)) {\n      const table = document.createElement('table');\n      const head = document.createElement('tr');\n      data.table.columns.forEach((column) => {\n        const th = document.createElement('th');\n        th.textContent = typeof column === 'string' ? column : String(column.name || '');\n        head.appendChild(th);\n      });\n      table.appendChild(head);\n      data.table.rows.forEach((row) => {\n        const tr = document.createElement('tr');\n        (Array.isArray(row) ? row : [row]).forEach((cell) => {\n          const td = document.createElement('td');\n          td.textContent = cell === null || cell === undefined ? '' : (typeof cell === 'object' ? JSON.stringify(cell) : String(cell));\n          tr.appendChild(td);\n        });\n        table.appendChild(tr);\n      });\n      resultBox.appendChild(table);\n      if (data.output && data.output.length) {\n        const pre = document.createElement('pre');\n        pre.textContent = data.output.join('\\n');\n        resultBox.appendChild(pre);\n      }\n      return;\n    }\n    const pre = document.createElement('pre');\n    pre.textContent = JSON.stringify(data, null, 2);\n    resultBox.appendChild(pre);\n  };\n  const connect = async () => {\n    setStatus(window.__gonaviPageText('connecting'));\n    try {\n      const data = await call('connect', {\n        connectionId: launch.connectionId || '',\n        database: launch.database || '',\n        collection: launch.collection || '',\n        connectionName: launch.connectionName || 'MongoDB',\n        environmentType: launch.environmentType || '',\n        readOnly: launch.readOnly === true,\n      });\n      if (typeof data.sessionId !== 'string' || !data.sessionId) {\n        throw new Error('The plugin backend did not return a sessionId.');\n      }\n      if (disposed) {\n        await release(data.sessionId);\n        return;\n      }\n      sessionId = data.sessionId;\n      conn.textContent = data && data.host ? data.host : (launch.connectionName || 'MongoDB');\n      if (data && Array.isArray(data.databases)) {\n        dbSelect.textContent = '';\n        data.databases.forEach((item) => {\n          const name = typeof item === 'string' ? item : String(item && (item.name || item.database) || '');\n          if (!name) return;\n          const option = document.createElement('option');\n          option.value = name;\n          option.textContent = name;\n          dbSelect.appendChild(option);\n        });\n        if (data.database) dbSelect.value = data.database;\n      }\n      collection.value = launch.collection || '';\n      dbSelect.disabled = false;\n      runButton.disabled = false;\n      setStatus(window.__gonaviPageText(data && data.readOnly ? 'readOnly' : 'ready'));\n    } catch (error) {\n      setStatus(window.__gonaviPageText('notConnected'));\n      setError(error);\n    }\n  };\n  const run = async () => {\n    if (!sessionId || disposed || running) return;\n    running = true;\n    runButton.disabled = true;\n    setStatus(window.__gonaviPageText('running'));\n    setError(null);\n    try {\n      const data = await call('run', {\n        sessionId,\n        script: editor.value,\n        database: dbSelect.value || '',\n        collection: collection.value.trim(),\n        maxRows: 200,\n      });\n      render(data);\n      setStatus(window.__gonaviPageText('done'));\n    } catch (error) {\n      setStatus(window.__gonaviPageText('failed'));\n      setError(error);\n    } finally {\n      running = false;\n      runButton.disabled = disposed || !sessionId;\n    }\n  };\n  runButton.addEventListener('click', run);\n  editor.addEventListener('keydown', (event) => {\n    if ((event.metaKey || event.ctrlKey) && event.key === 'Enter') {\n      event.preventDefault();\n      void run();\n    }\n  });\n  window.addEventListener('pagehide', dispose);\n  window.addEventListener('beforeunload', dispose);\n  conn.textContent = launch.connectionName || 'MongoDB';\n  void connect();\n})();\n</script>\n</body>\n</html>\n"
        }
      }
    ]
  }
}
