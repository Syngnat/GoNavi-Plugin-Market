{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "com.gonavi.mongo-shell",
  "name": "MongoShell",
  "version": "1.0.4",
  "description": "Interactive MongoDB JavaScript shell in a dedicated GoNavi window or workbench tab: connect with the saved connection, browse databases, and run bounded goja scripts with find, aggregate, insert, update, delete and runCommand.",
  "author": "GoNavi",
  "license": "Apache-2.0",
  "minHostVersion": "1.2.0",
  "permissions": [
    "host.connections.credentials",
    "host.log",
    "ai.skills",
    "ui.pages",
    "ui.html-panel"
  ],
  "permissionNotes": {
    "host.connections.credentials": "Reads the saved MongoDB configuration, including credentials, from the launch context. Credentials are used once and never returned.",
    "host.log": "Writes bounded connection diagnostics without credentials.",
    "ai.skills": "Ships the mongo-shell-recipes reference skill document for explicit Agent loading.",
    "ui.pages": "Opens the MongoShell page in a workbench tab.",
    "ui.html-panel": "Renders the inline MongoShell workbench page."
  },
  "backend": {
    "default": {
      "executable": "bin/plugin",
      "runtime": "native"
    }
  },
  "contributes": {
    "commands": [
      {
        "id": "connect",
        "title": "Connect to the saved MongoDB connection",
        "description": "Opens a driver client with the launch-context configuration, verifies it with a bounded ping and returns the database list.",
        "effect": "read",
        "inputSchema": {
          "type": "object",
          "properties": {
            "config": {
              "type": "object"
            },
            "readOnly": {
              "type": "boolean"
            },
            "database": {
              "type": "string",
              "maxLength": 255
            },
            "collection": {
              "type": "string",
              "maxLength": 255
            },
            "connectionId": {
              "type": "string",
              "maxLength": 128
            },
            "connectionName": {
              "type": "string",
              "maxLength": 256
            },
            "environmentType": {
              "type": "string",
              "maxLength": 64
            }
          },
          "required": [
            "config"
          ]
        }
      },
      {
        "id": "disconnect",
        "title": "Disconnect the MongoDB client",
        "effect": "read",
        "inputSchema": {
          "type": "object",
          "properties": {
            "sessionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "sessionId"
          ]
        }
      },
      {
        "id": "ping",
        "title": "Ping the MongoDB server",
        "effect": "read",
        "inputSchema": {
          "type": "object",
          "properties": {
            "sessionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "sessionId"
          ]
        }
      },
      {
        "id": "run",
        "title": "Run a JavaScript shell script",
        "description": "Executes a goja script with the db helper object, print and use. Results are bounded by maxRows and a command timeout.",
        "effect": "unknown",
        "inputSchema": {
          "type": "object",
          "properties": {
            "script": {
              "type": "string"
            },
            "database": {
              "type": "string",
              "maxLength": 255
            },
            "collection": {
              "type": "string",
              "maxLength": 255
            },
            "maxRows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            },
            "sessionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "script",
            "sessionId"
          ]
        }
      }
    ],
    "connectionActions": [
      {
        "id": "open-shell-tab",
        "title": "MongoShell",
        "description": "Open MongoShell in a workbench tab for this connection, database or collection.",
        "connectionTypes": [
          "mongodb"
        ],
        "scopes": [
          "connection",
          "database",
          "collection"
        ],
        "target": {
          "type": "page",
          "page": "shell"
        }
      }
    ],
    "skills": [
      {
        "id": "mongo-shell-recipes",
        "name": "MongoShell recipes",
        "description": "Reference for the bounded MongoShell JavaScript API: connection context, db/collection helpers, row limits, read-only behaviour and safe query patterns.",
        "entry": "skills/mongo-shell-recipes/SKILL.md"
      }
    ],
    "pages": [
      {
        "id": "shell",
        "title": "MongoShell",
        "html": {
          "source": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n<title>MongoShell</title>\n<style>\n  /* Same tokens as the rest of GoNavi: flat surfaces, hairline rules, one blue accent. */\n  :root {\n    color-scheme: light dark;\n    --surface: #ffffff;\n    --surface-sunken: #fafafb;\n    --surface-hover: #f5f7fa;\n    --border: #f0f0f2;\n    --border-strong: #e5e5ea;\n    --text: #1d1d24;\n    --text-secondary: #595964;\n    --text-muted: #8c8c96;\n    --accent: #1677ff;\n    --accent-hover: #4096ff;\n    --danger: #ff4d4f;\n    --danger-soft: #fef2f2;\n    --danger-border: #fecaca;\n    --danger-text: #b91c1c;\n    --radius: 8px;\n    --radius-sm: 4px;\n    --ui-font: Inter, -apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Noto Sans SC\", sans-serif;\n    --mono-font: \"JetBrains Mono\", SFMono-Regular, Menlo, Monaco, Consolas, monospace;\n  }\n  @media (prefers-color-scheme: dark) {\n    :root {\n      --surface: #16181d; --surface-sunken: #12141a; --surface-hover: #1f2229;\n      --border: #23262d; --border-strong: #2c3037;\n      --text: #e6e8ec; --text-secondary: #a0a4ad; --text-muted: #737780;\n      --accent: #4d9bff; --accent-hover: #6cadff;\n      --danger-soft: #2a1618; --danger-border: #4c2326; --danger-text: #ff9a9c;\n    }\n  }\n  * { box-sizing: border-box; }\n  html, body { margin: 0; min-height: 100%; }\n  body {\n    background: var(--surface);\n    color: var(--text);\n    font: 400 13px/1.5 var(--ui-font);\n    -webkit-font-smoothing: antialiased;\n  }\n  .shell { display: flex; flex-direction: column; min-height: 100vh; }\n\n  /* connection strip */\n  .strip {\n    display: flex; align-items: center; justify-content: space-between; gap: 12px;\n    min-height: 44px; padding: 8px 16px;\n    border-bottom: 1px solid var(--border); background: var(--surface);\n  }\n  .strip-id { display: flex; align-items: center; gap: 8px; min-width: 0; }\n  .monogram {\n    display: grid; place-items: center; width: 26px; height: 26px;\n    border: 1px solid var(--border-strong); border-radius: var(--radius-sm);\n    background: var(--surface-sunken); color: var(--accent);\n    font: 600 12px/1 var(--mono-font);\n  }\n  .strip-host {\n    color: var(--text-secondary); font: 400 12px/1.3 var(--mono-font);\n    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;\n  }\n  .strip-actions { display: flex; align-items: center; gap: 8px; flex: none; }\n  .chip {\n    display: inline-flex; align-items: center; height: 22px; padding: 0 8px;\n    border: 1px solid var(--border-strong); border-radius: var(--radius-sm);\n    background: var(--surface-sunken); color: var(--text-secondary);\n    font: 500 11px/1 var(--mono-font); white-space: nowrap;\n  }\n  .status {\n    display: inline-flex; align-items: center; gap: 6px; height: 24px; padding: 0 10px;\n    border: 1px solid var(--border-strong); border-radius: 999px;\n    background: var(--surface-sunken); color: var(--text-secondary);\n    font: 500 12px/1 var(--mono-font); white-space: nowrap;\n  }\n  .status::before { content: \"\"; width: 6px; height: 6px; border-radius: 50%; background: currentColor; opacity: .75; }\n\n  /* query toolbar */\n  .toolbar {\n    display: flex; align-items: center; gap: 14px; flex-wrap: wrap;\n    min-height: 46px; padding: 8px 16px;\n    border-bottom: 1px solid var(--border); background: var(--surface);\n  }\n  .field { display: flex; align-items: center; gap: 8px; min-width: 0; }\n  .field > span { color: var(--text-secondary); font: 500 12px/1 var(--ui-font); white-space: nowrap; }\n  .field-grow { flex: 1 1 200px; }\n  select, input {\n    height: 30px; min-width: 0; padding: 0 10px;\n    border: 1px solid var(--border-strong); border-radius: var(--radius);\n    background: var(--surface); color: var(--text);\n    font: 400 13px/1 var(--mono-font); outline: none;\n  }\n  .field-grow input { flex: 1; }\n  #maxrows { width: 76px; }\n  select:focus, input:focus, textarea:focus { border-color: var(--accent); box-shadow: 0 0 0 2px rgba(22,119,255,.15); }\n  select:disabled, input:disabled { background: var(--surface-sunken); color: var(--text-muted); }\n  .toolbar-actions { display: flex; align-items: center; gap: 8px; margin-left: auto; }\n  button {\n    height: 30px; padding: 0 12px;\n    border: 1px solid var(--border-strong); border-radius: var(--radius);\n    background: var(--surface); color: var(--text);\n    font: 500 12px/1 var(--ui-font); cursor: pointer;\n  }\n  button:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); }\n  button:disabled { opacity: .45; cursor: default; }\n  button.ghost { border-color: transparent; background: transparent; color: var(--text-secondary); }\n  button.ghost:hover:not(:disabled) { background: var(--surface-hover); color: var(--text); }\n  button.primary {\n    display: inline-flex; align-items: center; gap: 6px; padding: 0 10px 0 14px;\n    border-color: var(--accent); background: var(--accent); color: #fff;\n  }\n  button.primary:hover:not(:disabled) { background: var(--accent-hover); border-color: var(--accent-hover); color: #fff; }\n  button.primary kbd {\n    padding: 2px 5px; border-radius: var(--radius-sm);\n    background: rgba(255,255,255,.18); color: rgba(255,255,255,.92);\n    font: 500 10px/1 var(--mono-font);\n  }\n\n  /* error banner */\n  .error {\n    display: flex; align-items: baseline; gap: 10px;\n    padding: 8px 16px;\n    border-bottom: 1px solid var(--danger-border);\n    background: var(--danger-soft); color: var(--danger-text);\n    font: 400 12px/1.5 var(--ui-font); white-space: pre-wrap; overflow-wrap: anywhere;\n  }\n  .error[hidden] { display: none; }\n\n  /* panes */\n  .pane { display: flex; flex-direction: column; min-height: 0; }\n  .pane-header {\n    display: flex; align-items: center; justify-content: space-between; gap: 12px;\n    height: 32px; padding: 0 16px;\n    border-bottom: 1px solid var(--border); background: var(--surface-sunken);\n  }\n  .pane-title {\n    display: inline-flex; align-items: center; gap: 6px;\n    font: 600 11px/1 var(--ui-font); letter-spacing: .04em; text-transform: uppercase;\n  }\n  .pane-title::before { content: \"\"; width: 5px; height: 5px; border-radius: 50%; background: var(--accent); }\n  .pane-meta {\n    color: var(--text-muted); font: 400 12px/1 var(--mono-font);\n    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;\n  }\n  .pane-meta.warn { color: #b45309; }\n  #editor {\n    width: 100%; min-height: 170px; margin: 0; padding: 12px 16px;\n    border: 0; border-bottom: 1px solid var(--border);\n    background: var(--surface); color: var(--text);\n    font: 400 12.5px/1.65 var(--mono-font); tab-size: 2; resize: vertical; outline: none;\n  }\n  .result-pane { flex: 1; min-height: 0; }\n  #result {\n    flex: 1; min-height: 120px; max-height: 52vh; overflow: auto;\n    padding: 0; background: var(--surface);\n  }\n  #result[hidden] { display: none; }\n  #result table { width: 100%; border-collapse: collapse; font: 400 12px/1.5 var(--mono-font); }\n  #result th {\n    position: sticky; top: 0; z-index: 10; height: 30px; padding: 0 12px;\n    border-bottom: 1px solid var(--border); background: var(--surface-sunken);\n    color: var(--text-secondary); font: 500 11px/1 var(--mono-font);\n    letter-spacing: .04em; text-transform: uppercase; text-align: left; white-space: nowrap;\n  }\n  #result td {\n    height: 28px; padding: 0 12px; border-bottom: 1px solid var(--border);\n    color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 320px;\n  }\n  #result tr:hover td { background: var(--surface-hover); }\n  #result pre {\n    margin: 0; padding: 10px 16px; border-top: 1px solid var(--border);\n    background: var(--surface-sunken); color: var(--text-secondary);\n    font: 400 12px/1.6 var(--mono-font); white-space: pre-wrap;\n  }\n  .empty { padding: 18px 16px; color: var(--text-muted); font: 400 12px/1.6 var(--ui-font); }\n\n  .footer {\n    display: flex; align-items: center; gap: 10px;\n    height: 28px; padding: 0 16px; margin-top: auto;\n    border-top: 1px solid var(--border); background: var(--surface);\n    color: var(--text-muted); font: 400 11.5px/1 var(--mono-font);\n  }\n  .footer .spacer { flex: 1; }\n  .footer .danger { color: var(--danger); }\n</style>\n</head>\n<body>\n<script>\n  // 工作台页是内嵌 iframe：宿主通过 gonavi:host-preferences 注入 locale，\n  // 这里只做最小词典，未识别的语言一律回退英文。\n  (function () {\n    const table = {\n      'zh-CN': { database: '数据库', collection: '集合', optional: '可选集合', run: '运行', clear: '清空', maxRows: '最大行数', script: '脚本', result: '结果', starting: '启动中', connecting: '连接中', ready: '就绪', readOnly: '只读', notConnected: '未连接', running: '执行中', done: '完成', failed: '失败', noQuery: '尚未查询', empty: '运行脚本后，命中结果会显示在这里。', writes: '允许写入', writesOff: '只读连接', truncated: '已达行数上限，仅显示前 {{rows}} 行。' },\n      'zh-TW': { database: '資料庫', collection: '集合', optional: '選填集合', run: '執行', clear: '清空', maxRows: '最大列數', script: '腳本', result: '結果', starting: '啟動中', connecting: '連線中', ready: '就緒', readOnly: '唯讀', notConnected: '未連線', running: '執行中', done: '完成', failed: '失敗', noQuery: '尚未查詢', empty: '執行腳本後，命中結果會顯示在這裡。', writes: '允許寫入', writesOff: '唯讀連線', truncated: '已達列數上限，僅顯示前 {{rows}} 列。' },\n      'ja-JP': { database: 'データベース', collection: 'コレクション', optional: '任意のコレクション', run: '実行', clear: 'クリア', maxRows: '最大行数', script: 'スクリプト', result: '結果', starting: '起動中', connecting: '接続中', ready: '準備完了', readOnly: '読み取り専用', notConnected: '未接続', running: '実行中', done: '完了', failed: '失敗', noQuery: '未実行', empty: 'スクリプトを実行すると結果がここに表示されます。', writes: '書き込み可', writesOff: '読み取り専用', truncated: '行数上限に達しました。先頭 {{rows}} 行のみ表示します。' },\n      'de-DE': { database: 'Datenbank', collection: 'Collection', optional: 'optionale Collection', run: 'Ausführen', clear: 'Leeren', maxRows: 'Max. Zeilen', script: 'Skript', result: 'Ergebnis', starting: 'Startet', connecting: 'Verbinden', ready: 'Bereit', readOnly: 'Schreibgeschützt', notConnected: 'Nicht verbunden', running: 'Läuft', done: 'Fertig', failed: 'Fehlgeschlagen', noQuery: 'Noch keine Abfrage', empty: 'Skript ausführen, um Ergebnisse zu sehen.', writes: 'Schreiben erlaubt', writesOff: 'Schreibgeschützt', truncated: 'Zeilenlimit erreicht: nur die ersten {{rows}} Zeilen.' },\n      'ru-RU': { database: 'База данных', collection: 'Коллекция', optional: 'необязательная коллекция', run: 'Выполнить', clear: 'Очистить', maxRows: 'Максимум строк', script: 'Скрипт', result: 'Результат', starting: 'Запуск', connecting: 'Подключение', ready: 'Готово', readOnly: 'Только чтение', notConnected: 'Нет подключения', running: 'Выполняется', done: 'Готово', failed: 'Ошибка', noQuery: 'Запросов ещё не было', empty: 'Выполните скрипт, чтобы увидеть результаты.', writes: 'Запись разрешена', writesOff: 'Только чтение', truncated: 'Достигнут лимит строк: показаны первые {{rows}}.' },\n      'en-US': { database: 'Database', collection: 'Collection', optional: 'optional collection', run: 'Run', clear: 'Clear', maxRows: 'Max rows', script: 'Script', result: 'Result', starting: 'starting', connecting: 'connecting', ready: 'ready', readOnly: 'read-only', notConnected: 'not connected', running: 'running', done: 'done', failed: 'failed', noQuery: 'No query yet', empty: 'Run a script to see documents here.', writes: 'Writes enabled', writesOff: 'Read-only', truncated: 'Row limit reached: showing the first {{rows}} rows.' },\n    };\n    const resolve = () => {\n      const prefs = window.gonaviHostPrefs;\n      const raw = prefs && typeof prefs.locale === 'string' ? prefs.locale : ((typeof navigator !== 'undefined' && navigator.language) || 'en-US');\n      if (table[raw]) return raw;\n      const lower = String(raw).toLowerCase();\n      if (lower.indexOf('zh') === 0) return lower.indexOf('tw') > -1 || lower.indexOf('hk') > -1 ? 'zh-TW' : 'zh-CN';\n      const base = lower.split('-')[0];\n      for (const key of Object.keys(table)) { if (key.toLowerCase().indexOf(base + '-') === 0) return key; }\n      return 'en-US';\n    };\n    window.__gonaviPageText = (key, params) => {\n      const dict = table[resolve()] || table['en-US'];\n      let text = dict[key] || table['en-US'][key] || key;\n      if (params && typeof text === 'string') {\n        for (const name of Object.keys(params)) text = text.split('{{' + name + '}}').join(String(params[name]));\n      }\n      return text;\n    };\n    const apply = () => {\n      for (const node of document.querySelectorAll('[data-i18n]')) node.textContent = window.__gonaviPageText(node.dataset.i18n);\n      for (const node of document.querySelectorAll('[data-i18n-placeholder]')) node.setAttribute('placeholder', window.__gonaviPageText(node.dataset.i18nPlaceholder));\n    };\n    if (typeof window.addEventListener === 'function') {\n      window.addEventListener('message', (event) => {\n        const data = event && event.data;\n        if (data && data.type === 'gonavi:host-preferences') apply();\n      });\n    }\n    if (typeof document.addEventListener === 'function') document.addEventListener('DOMContentLoaded', apply);\n  }());\n</script>\n<div class=\"shell\">\n  <div class=\"strip\">\n    <div class=\"strip-id\">\n      <span class=\"monogram\" aria-hidden=\"true\">M</span>\n      <span id=\"conn\" class=\"strip-host\">MongoDB</span>\n    </div>\n    <div class=\"strip-actions\">\n      <span id=\"env\" class=\"chip\" hidden></span>\n      <span id=\"readonly\" class=\"chip\" hidden data-i18n=\"readOnly\">read-only</span>\n      <span id=\"status\" class=\"status\" data-i18n=\"starting\">starting</span>\n    </div>\n  </div>\n\n  <div id=\"error\" class=\"error\" role=\"alert\" hidden></div>\n\n  <div class=\"toolbar\">\n    <label class=\"field\">\n      <span data-i18n=\"database\">Database</span>\n      <select id=\"db\" disabled><option value=\"\">(none)</option></select>\n    </label>\n    <label class=\"field field-grow\">\n      <span data-i18n=\"collection\">Collection</span>\n      <input id=\"collection\" placeholder=\"optional collection\" data-i18n-placeholder=\"optional\" />\n    </label>\n    <label class=\"field\">\n      <span data-i18n=\"maxRows\">Max rows</span>\n      <input id=\"maxrows\" type=\"number\" min=\"1\" max=\"2000\" step=\"1\" value=\"200\" />\n    </label>\n    <div class=\"toolbar-actions\">\n      <button id=\"clear\" class=\"ghost\" type=\"button\" data-i18n=\"clear\">Clear</button>\n      <button id=\"run\" class=\"primary\" type=\"button\" disabled>\n        <span data-i18n=\"run\">Run</span>\n        <kbd>⌘/Ctrl ↵</kbd>\n      </button>\n    </div>\n  </div>\n\n  <section class=\"pane\">\n    <header class=\"pane-header\">\n      <span class=\"pane-title\" data-i18n=\"script\">Script</span>\n      <span id=\"scope\" class=\"pane-meta\"></span>\n    </header>\n    <textarea id=\"editor\" spellcheck=\"false\" aria-label=\"MongoShell JavaScript\">db.getCollectionNames()</textarea>\n  </section>\n\n  <section class=\"pane result-pane\">\n    <header class=\"pane-header\">\n      <span class=\"pane-title\" data-i18n=\"result\">Result</span>\n      <span id=\"resultMeta\" class=\"pane-meta\" data-i18n=\"noQuery\">No query yet</span>\n    </header>\n    <div id=\"result\" hidden></div>\n    <div id=\"empty\" class=\"empty\" data-i18n=\"empty\">Run a script to see documents here.</div>\n  </section>\n\n  <div class=\"footer\">\n    <span id=\"footerHost\">—</span>\n    <span id=\"footerWrites\" data-i18n=\"writes\">Writes enabled</span>\n    <span class=\"spacer\"></span>\n    <span id=\"footerElapsed\">—</span>\n  </div>\n</div>\n<script>\n(() => {\n  const launch = window.__gonaviLaunch || {};\n  const conn = document.getElementById('conn');\n  const dbSelect = document.getElementById('db');\n  const collection = document.getElementById('collection');\n  const editor = document.getElementById('editor');\n  const runButton = document.getElementById('run');\n  const clearButton = document.getElementById('clear');\n  const maxRowsInput = document.getElementById('maxrows');\n  const status = document.getElementById('status');\n  const errorBox = document.getElementById('error');\n  const resultBox = document.getElementById('result');\n  const emptyBox = document.getElementById('empty');\n  const resultMeta = document.getElementById('resultMeta');\n  const scope = document.getElementById('scope');\n  const envChip = document.getElementById('env');\n  const readonlyChip = document.getElementById('readonly');\n  const footerHost = document.getElementById('footerHost');\n  const footerWrites = document.getElementById('footerWrites');\n  const footerElapsed = document.getElementById('footerElapsed');\n  let sessionId = '';\n  let disposed = false;\n  let running = false;\n  const text = (key, params) => (typeof window.__gonaviPageText === 'function' ? window.__gonaviPageText(key, params) : key);\n  const setStatus = (value) => { status.textContent = value; };\n  const setError = (error) => {\n    const message = error && (error.message || error.code) ? String(error.message || error.code) : String(error || '');\n    errorBox.hidden = !message;\n    errorBox.textContent = message;\n  };\n  const maxRows = () => {\n    const value = maxRowsInput ? Number(maxRowsInput.value) : 200;\n    if (!Number.isFinite(value) || value < 1) return 200;\n    return Math.min(2000, Math.floor(value));\n  };\n  const call = async (command, args) => {\n    const payload = await window.gonavi.call('plugin.invoke', {\n      command,\n      arguments: args || {},\n      connectionId: launch.connectionId || '',\n    });\n    if (!payload || typeof payload !== 'object' || typeof payload.ok !== 'boolean') {\n      throw new Error('The plugin backend returned an invalid response.');\n    }\n    if (!payload.ok) {\n      const failure = payload.error || {};\n      const error = new Error(failure.message || failure.code || 'The command failed.');\n      error.code = failure.code || 'internal';\n      throw error;\n    }\n    if (!payload.data || typeof payload.data !== 'object') {\n      throw new Error('The plugin backend returned invalid data.');\n    }\n    return payload.data;\n  };\n  const release = (id) => call('disconnect', { sessionId: id }).catch(() => {});\n  const dispose = () => {\n    disposed = true;\n    const id = sessionId;\n    sessionId = '';\n    runButton.disabled = true;\n    dbSelect.disabled = true;\n    if (id) void release(id);\n  };\n  const setScope = () => {\n    if (!scope) return;\n    const database = dbSelect.value || launch.database || '(default)';\n    const name = collection.value.trim();\n    scope.textContent = name ? database + ' / ' + name : database;\n  };\n  const render = (data) => {\n    resultBox.hidden = false;\n    resultBox.textContent = '';\n    if (emptyBox) emptyBox.hidden = true;\n    if (data && data.table && Array.isArray(data.table.columns) && Array.isArray(data.table.rows)) {\n      const table = document.createElement('table');\n      const head = document.createElement('tr');\n      data.table.columns.forEach((column) => {\n        const th = document.createElement('th');\n        th.textContent = typeof column === 'string' ? column : String(column.name || '');\n        head.appendChild(th);\n      });\n      table.appendChild(head);\n      data.table.rows.forEach((row) => {\n        const tr = document.createElement('tr');\n        (Array.isArray(row) ? row : [row]).forEach((cell) => {\n          const td = document.createElement('td');\n          td.textContent = cell === null || cell === undefined ? '' : (typeof cell === 'object' ? JSON.stringify(cell) : String(cell));\n          tr.appendChild(td);\n        });\n        table.appendChild(tr);\n      });\n      resultBox.appendChild(table);\n      if (data.output && data.output.length) {\n        const pre = document.createElement('pre');\n        pre.textContent = data.output.join('\\n');\n        resultBox.appendChild(pre);\n      }\n      return;\n    }\n    const pre = document.createElement('pre');\n    pre.textContent = JSON.stringify(data, null, 2);\n    resultBox.appendChild(pre);\n  };\n  const setResultMeta = (data) => {\n    const rows = data && data.table && Array.isArray(data.table.rows) ? data.table.rows.length : 0;\n    const elapsed = data && typeof data.elapsedMs === 'number' ? data.elapsedMs : null;\n    const truncated = Boolean(data && data.table && data.table.truncated);\n    if (resultMeta) {\n      resultMeta.textContent = truncated ? text('truncated', { rows }) : rows + ' row(s)' + (elapsed === null ? '' : ' · ' + elapsed + ' ms');\n      if (resultMeta.classList) resultMeta.classList.toggle('warn', truncated);\n    }\n    if (footerElapsed) footerElapsed.textContent = elapsed === null ? '—' : elapsed + ' ms';\n  };\n  const connect = async () => {\n    setStatus(text('connecting'));\n    try {\n      const data = await call('connect', {\n        connectionId: launch.connectionId || '',\n        database: launch.database || '',\n        collection: launch.collection || '',\n        connectionName: launch.connectionName || 'MongoDB',\n        environmentType: launch.environmentType || '',\n        readOnly: launch.readOnly === true,\n      });\n      if (typeof data.sessionId !== 'string' || !data.sessionId) {\n        throw new Error('The plugin backend did not return a sessionId.');\n      }\n      if (disposed) {\n        await release(data.sessionId);\n        return;\n      }\n      sessionId = data.sessionId;\n      conn.textContent = data && data.host ? data.host : (launch.connectionName || 'MongoDB');\n      if (footerHost) footerHost.textContent = (data && data.host) || (launch.connectionName || 'MongoDB');\n      if (envChip) {\n        envChip.hidden = !launch.environmentType;\n        if (launch.environmentType) envChip.textContent = String(launch.environmentType);\n      }\n      if (readonlyChip) readonlyChip.hidden = !(data && data.readOnly);\n      if (footerWrites) footerWrites.textContent = text(data && data.readOnly ? 'writesOff' : 'writes');\n      if (footerWrites) footerWrites.className = data && data.readOnly ? 'danger' : '';\n      if (data && Array.isArray(data.databases)) {\n        dbSelect.textContent = '';\n        data.databases.forEach((item) => {\n          const name = typeof item === 'string' ? item : String(item && (item.name || item.database) || '');\n          if (!name) return;\n          const option = document.createElement('option');\n          option.value = name;\n          option.textContent = name;\n          dbSelect.appendChild(option);\n        });\n        if (data.database) dbSelect.value = data.database;\n      }\n      collection.value = launch.collection || '';\n      dbSelect.disabled = false;\n      runButton.disabled = false;\n      setScope();\n      setStatus(text(data && data.readOnly ? 'readOnly' : 'ready'));\n    } catch (error) {\n      setStatus(text('notConnected'));\n      setError(error);\n      if (error && typeof console !== 'undefined' && console.error) console.error('mongo-shell connect failed', error);\n    }\n  };\n  const run = async () => {\n    if (!sessionId || disposed || running) return;\n    running = true;\n    runButton.disabled = true;\n    setStatus(text('running'));\n    setError(null);\n    try {\n      const data = await call('run', {\n        sessionId,\n        script: editor.value,\n        database: dbSelect.value || '',\n        collection: collection.value.trim(),\n        maxRows: maxRows(),\n      });\n      render(data);\n      setResultMeta(data);\n      setStatus(text('done'));\n    } catch (error) {\n      setStatus(text('failed'));\n      setError(error);\n    } finally {\n      running = false;\n      runButton.disabled = disposed || !sessionId;\n    }\n  };\n  runButton.addEventListener('click', run);\n  if (clearButton) {\n    clearButton.addEventListener('click', () => {\n      editor.value = '';\n      resultBox.hidden = true;\n      resultBox.textContent = '';\n      if (emptyBox) emptyBox.hidden = false;\n      resultMeta.textContent = text('noQuery');\n      resultMeta.classList.remove('warn');\n      if (footerElapsed) footerElapsed.textContent = '—';\n      setError(null);\n      editor.focus();\n    });\n  }\n  if (dbSelect && typeof dbSelect.addEventListener === 'function') dbSelect.addEventListener('change', setScope);\n  if (collection && typeof collection.addEventListener === 'function') collection.addEventListener('input', setScope);\n  editor.addEventListener('keydown', (event) => {\n    if ((event.metaKey || event.ctrlKey) && event.key === 'Enter') {\n      event.preventDefault();\n      void run();\n    }\n  });\n  window.addEventListener('pagehide', dispose);\n  window.addEventListener('beforeunload', dispose);\n  conn.textContent = launch.connectionName || 'MongoDB';\n  if (footerHost) footerHost.textContent = launch.connectionName || 'MongoDB';\n  void connect();\n})();\n</script>\n</body>\n</html>\n"
        }
      }
    ]
  }
}
